{
  "name": "@transitive-bullshit/skills",
  "version": "0.0.0",
  "private": true,
  "description": "My personal agent skills.",
  "license": "MIT",
  "author": "Travis Fischer <travis@transitivebullsh.it>",
  "repository": "https://github.com/transitive-bullshit/skills",
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "test": "run-s test:*",
    "test:format": "oxfmt --check",
    "test:lint": "oxlint",
    "fix": "run-s fix:*",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix"
  },
  "devDependencies": {
    "@fisch0920/config": "^2.1.4",
    "@types/node": "^26.4.1",
    "lint-staged": "^17.4.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.3.4"
}
